[Unit]
Description=Portfolio Flask application
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/portfolio
Environment="PATH=/home/ubuntu/portfolio/.venv/bin"
ExecStart=/home/ubuntu/portfolio/.venv/bin/python app.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
